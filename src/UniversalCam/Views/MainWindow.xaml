<Window
    x:Class="UniversalCam.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UniversalCam.Views"
    Title="UniversalCam"
    Icon="../universal_cam.ico"
    Width="1280" Height="720"
    MinWidth="800" MinHeight="480"
    Background="#1C1C1C"
    WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <local:BoolToHighlightConverter x:Key="BoolToHighlightConverter" />
        <local:BoolToAccentConverter   x:Key="BoolToAccentConverter" />

        <SolidColorBrush x:Key="UsbBadgeBrush"  Color="#FF8800" />
        <SolidColorBrush x:Key="WifiBadgeBrush" Color="#0A84FF" />
        <SolidColorBrush x:Key="AccentBrush"    Color="#512BD4" />

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background"   Value="#2D2D30" />
            <Setter Property="Foreground"   Value="White" />
            <Setter Property="BorderBrush"  Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"      Value="8,5" />
            <Setter Property="FontSize"     Value="12" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#512BD4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggle" TargetType="ToggleButton">
            <Setter Property="Background"   Value="#2D2D30" />
            <Setter Property="Foreground"   Value="White" />
            <Setter Property="BorderBrush"  Value="#444" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"      Value="8,5" />
            <Setter Property="FontSize"     Value="12" />
            <Setter Property="Cursor"       Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#512BD4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E42" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10" />
            <Setter Property="FontWeight"   Value="SemiBold" />
            <Setter Property="Foreground"   Value="#888" />
            <Setter Property="Margin"       Value="12,12,0,4" />
        </Style>

        <Style x:Key="QualityRadio" TargetType="RadioButton">
            <Setter Property="Foreground"   Value="White" />
            <Setter Property="FontSize"     Value="13" />
            <Setter Property="Margin"       Value="12,3,0,3" />
            <Setter Property="Cursor"       Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ SIDEBAR (Col 0, Row 0) ═══════════════════════════════════════════ -->
        <Border Grid.Column="0" Grid.Row="0"
                Background="#1E1E1E"
                BorderBrush="#333"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- Wordmark -->
                <Image DockPanel.Dock="Top"
                       Source="../Assets/wordmark.png"
                       Height="28"
                       HorizontalAlignment="Left"
                       Margin="14,14,14,10"
                       Stretch="Uniform"
                       StretchDirection="DownOnly" />

                <!-- Device name + status -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                    <TextBlock x:Name="txtDeviceName"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="No device" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse x:Name="ellStatus"
                                 Width="8" Height="8"
                                 Fill="Gray"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0" />
                        <TextBlock x:Name="txtStatus"
                                   FontSize="12"
                                   Foreground="#AAA"
                                   VerticalAlignment="Center"
                                   Text="Idle" />
                        <Border x:Name="badgeTransport"
                                CornerRadius="3"
                                Padding="5,1"
                                Margin="6,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="txtTransport"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="#333" Margin="0,0,0,0" />

                <!-- BACK cameras -->
                <StackPanel x:Name="pnlBack"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed">
                    <TextBlock Style="{StaticResource GroupHeader}" Text="BACK" />
                    <ItemsControl x:Name="icBackCameras">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Id}"
                                        Click="OnCameraRowClicked"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Border CornerRadius="4" Padding="10,6" Margin="6,2"
                                            Background="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding IsSelected, Converter={StaticResource BoolToAccentConverter}}" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- FRONT cameras -->
                <StackPanel x:Name="pnlFront"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource GroupHeader}" Text="FRONT" />
                    <ItemsControl x:Name="icFrontCameras">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Id}"
                                        Click="OnCameraRowClicked"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Border CornerRadius="4" Padding="10,6" Margin="6,2"
                                            Background="{Binding IsSelected, Converter={StaticResource BoolToHighlightConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding IsSelected, Converter={StaticResource BoolToAccentConverter}}" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Separator DockPanel.Dock="Top" Background="#333" />

                <!-- Quality -->
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource GroupHeader}"
                           Text="QUALITY" />

                <RadioButton DockPanel.Dock="Top"
                             x:Name="rb1080p"
                             Style="{StaticResource QualityRadio}"
                             Content="1080p · 30fps"
                             IsChecked="True"
                             Checked="OnQualityChanged" />

                <RadioButton DockPanel.Dock="Top"
                             x:Name="rb4K"
                             Style="{StaticResource QualityRadio}"
                             Content="4K · 30fps"
                             Checked="OnQualityChanged" />

                <Separator DockPanel.Dock="Top" Background="#333" Margin="0,8,0,0" />

                <!-- Audio VU -->
                <StackPanel DockPanel.Dock="Top" Margin="12,10,12,4">
                    <TextBlock Style="{StaticResource GroupHeader}"
                               Margin="0,0,0,4"
                               Text="AUDIO" />
                    <ProgressBar x:Name="pbVolume"
                                 Height="6"
                                 Minimum="0" Maximum="1" Value="0"
                                 IsEnabled="False" />
                </StackPanel>

                <!-- Controls at bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <UniformGrid Columns="2" Rows="1" Margin="0,0,0,6">
                        <ToggleButton x:Name="btnMute"
                                      Style="{StaticResource SidebarToggle}"
                                      Content="Mute"
                                      IsEnabled="False"
                                      Margin="0,0,4,0"
                                      Click="OnMuteClicked" />
                        <Button x:Name="btnRotate"
                                Style="{StaticResource SidebarButton}"
                                Content="Rotate"
                                Margin="4,0,0,0"
                                Click="OnRotateClicked" />
                    </UniformGrid>
                    <Button x:Name="btnStop"
                            Style="{StaticResource SidebarButton}"
                            Content="Stop Stream"
                            IsEnabled="False"
                            Click="OnStopClicked" />
                </StackPanel>

                <!-- IP hint (fills remaining vertical space) -->
                <TextBlock DockPanel.Dock="Bottom"
                           x:Name="txtIpHint"
                           FontSize="11"
                           Foreground="#555"
                           Margin="12,4,12,8"
                           TextWrapping="Wrap" />

            </DockPanel>
        </Border>

        <!-- ══ VIDEO AREA (Col 1, Row 0) ════════════════════════════════════════ -->
        <Grid Grid.Column="1" Grid.Row="0" Background="#1C1C1C">

            <!-- Video preview -->
            <Image x:Name="imgPreview"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.LayoutTransform>
                    <RotateTransform x:Name="imgRotation" Angle="0" />
                </Image.LayoutTransform>
            </Image>

            <!-- Placeholder when no stream -->
            <StackPanel x:Name="pnlNoStream"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock FontSize="64"
                           Foreground="#555"
                           HorizontalAlignment="Center"
                           Text="📷" />
                <TextBlock x:Name="txtWaiting"
                           FontSize="18"
                           Foreground="#888"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Text="Waiting for iPhone…" />
            </StackPanel>

        </Grid>

        <!-- ══ STATUS BAR (Col 0+1, Row 1) ══════════════════════════════════════ -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Background="#CC1A1A1A"
                BorderBrush="#333"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Resolution / info -->
                <TextBlock x:Name="txtInfo"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="#888"
                           VerticalAlignment="Center" />

                <!-- Latency -->
                <TextBlock x:Name="txtLatency"
                           Grid.Column="1"
                           FontSize="12"
                           Foreground="#666"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
